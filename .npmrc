package-manager-strict-version=false
trust-policy=permissive

# Security: block all dependency lifecycle scripts by default
strictDepBuilds=true

# ignoredBuilds: packages whose scripts are not needed (warning suppressed)
# - core-js / core-js-pure: postinstall is just a donation banner
ignoredBuilds[]=core-js
ignoredBuilds[]=core-js-pure

# undici-types: type-only package, no build needed
trust-policy-exclude[]=undici-types@6.21.0
public-hoist-pattern[]=miniflare
