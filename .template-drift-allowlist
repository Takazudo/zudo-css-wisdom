# Template drift allowlist for zudo-css-wisdom.
# Generated projects start from create-zudo-doc templates; this file lists
# intentional divergences so `pnpm check:template-drift` exits 0.
#
# Format: one repo-relative path per line (no leading slash).
# Blank lines and `#` comments are ignored.

# .zfb/ directory is gitignored; doc-history-meta.json is written at build
# time by the doc-history plugin. It does not exist in the working tree.
.zfb/doc-history-meta.json

# scripts/run-b4push.sh is intentionally customized for this consuming site
# (full 8-step gate: format + drift + pin-parity + wrangler-pin + check + build
# + html + links; replaces the 4-step template default).
scripts/run-b4push.sh

# pages/lib/_chrome.ts — site-specific MDX `mdxExtras` added (zudo-doc 2.0.0).
# The 2.0.0 host chrome adapter (Collapse Wiring Shells) threads host-bound MDX
# component overrides through `createChrome(..., { mdxExtras })`. This site adds
# its zcss-specific demo islands (CssPreview / TailwindPreview) plus showcase
# placeholder stubs (Badge / Dialog / MDXRemote / ProductCard / Teleport) to the
# template's default extras block so the docs corpus's custom tags resolve.
# (The former pages/_mdx-components.ts — incl. the imageEnlarge ENLARGE_SVG +
# paragraph override and the img base-rewrite — is gone: createMdxComponents now
# bakes img/p/admonitions/CodeGroup/Math/nav in the package; only the genuinely
# site-bound extras remain here.) Intentional divergence from the base template.
pages/lib/_chrome.ts

# src/config/settings-types.ts — @slot:settings-types:trigger-names markers removed.
# The base template ships @slot: markers so compose can inject feature-specific
# trigger name types. Production has these slots resolved and removed.
src/config/settings-types.ts

# src/styles/global.css — @slot markers resolved; doc-history diff viewer CSS added;
# Noto Sans JP webfont @import added.
# The base template ships @slot:global-css:theme-tokens and
# @slot:global-css:feature-styles injection markers. Production has these
# slots resolved (removed) and the real doc-history diff viewer CSS inlined
# in place of the feature-styles slot (docHistory: true). It also @imports the
# Noto Sans JP webfont here (zudo-doc 2.0.0 collapsed the host <head> into the
# package chrome, so the former async <link> in pages/lib/_head-with-defaults.tsx
# moved to CSS — applies uniformly to home + every doc page via --font-noto).
src/styles/global.css

# Feature-island re-export shims — these three components ship a base no-op
# W6A stub AND a feature re-export shim in create-zudo-doc 1.x. This site has
# the corresponding features enabled (imageEnlarge, docHistory, sidebarToggle),
# so production carries the FEATURE shim (re-exporting the real island from the
# package), which differs from the base stub the drift check compares first.
# Intentional: matches the package-first 1.x baseline.
src/components/desktop-sidebar-toggle.tsx
src/components/doc-history.tsx
src/components/image-enlarge.tsx

# docTags feature — tags pages are present in the docTags feature template
# but this site has `docTags: false` in settings.ts (tags UI disabled).
# The tag data model and frontmatter field are kept for future use, but
# the tags index/detail pages are intentionally absent.
pages/[locale]/docs/tags/[tag].tsx
pages/[locale]/docs/tags/index.tsx
pages/docs/tags/[tag].tsx
pages/docs/tags/index.tsx
pages/lib/_tag-pages.tsx

# tagGovernance — tags-audit.ts and tags-suggest.ts scripts are present in the
# tagGovernance feature template but have not been scaffolded for this site
# (tagGovernance: "off"). Intentionally absent; add later if tag governance is enabled.
scripts/tags-audit.ts
scripts/tags-suggest.ts

# mermaid-enlarge feature — create-zudo-doc 0.2.10 added a new optional island
# (enlarge + zoom/pan affordance for client-rendered mermaid diagrams), wired in
# the template via src/components/mermaid-enlarge.tsx + its island registration in
# pages/lib/_body-end-islands.tsx (already allowlisted) + CSS in the template
# global.css. This site has NOT opted into it (no references in prod). Intentionally
# absent; adopt later as a separate task if mermaid-diagram enlarge is wanted.
src/components/mermaid-enlarge.tsx

# src/components/css-preview.tsx — zcss-specific CssPreview demo component.
# This component is unique to zudo-css-wisdom (no template equivalent).
src/components/css-preview.tsx

# pages/index.tsx and pages/[locale]/index.tsx — h1 uses `font-futura font-normal`
# (brand typography divergence). The template ships a generic heading; this site
# applies the Futura PT brand font for the homepage hero. Same rationale as the
# locale variant already noted in the cloudflare wisdom reference.
pages/index.tsx
pages/[locale]/index.tsx

# src/config/color-scheme-utils.ts — safety-improved null-check pattern.
# Uses indexed access (`entries[0]`) instead of destructuring with a guard to
# avoid potential undefined dereference. Functionally equivalent; local improvement.
src/config/color-scheme-utils.ts

# src/config/frontmatter-preview-defaults.ts — template has extra fields.
# The template version includes `doc_history`, `category_no_page`, and
# `category_sort_order` fields that belong with the full schema. These fields
# have not yet been added to this site's frontmatter-preview defaults.
# Intentional: adopt when those features are fully wired.
src/config/frontmatter-preview-defaults.ts

# src/config/frontmatter-preview-renderers.tsx — local vs. package type imports.
# Uses different type import paths (local module vs. package re-export) and a
# different ComponentType import path. Functionally identical; local path variant.
src/config/frontmatter-preview-renderers.tsx

# src/config/sidebars.ts — custom sidebar structure for zcss categories.
# Defines zcss-specific sidebar groups: layout, methodology, etc. The template
# ships a generic placeholder sidebar. Intentional site-specific divergence.
src/config/sidebars.ts

# src/types/locale.ts — comment says "Astro" not "Preact".
# Minor cosmetic difference in an internal comment. Functionally identical.
src/types/locale.ts

# src/utils/base.ts — has extra `docsHrefForNav` function.
# This utility provides default-locale-only prefixes for nav hrefs (strips the
# locale prefix for the default locale). Not present in the template baseline.
src/utils/base.ts

# src/utils/docs.ts — uses `docsHrefForNav` instead of `docsUrl` in nav href building.
# The nav link builder uses the custom `docsHrefForNav` (from src/utils/base.ts)
# rather than the template's generic `docsUrl`. Intentional: matches the
# default-locale href stripping behaviour needed for this bilingual site.
src/utils/docs.ts

# tsconfig.json — adds `"scripts/__tests__"` to exclude list.
# Keeps the test helper files from being included in the main tsc compilation
# (they are covered by their own tsconfig). Template does not exclude this path.
tsconfig.json

