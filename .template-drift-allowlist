# This project uses `plugins/claude-resources-plugin.mjs` (zfb plugin approach)
# instead of the template's `src/integrations/` Astro integration approach.
# The four files below (two source files + two test files) belong to the Astro
# integration variant and are not needed in this zfb-based setup.
src/integrations/claude-resources/__tests__/escape-for-mdx.test.ts
src/integrations/claude-resources/__tests__/generate.test.ts
src/integrations/claude-resources/escape-for-mdx.ts
src/integrations/claude-resources/generate.ts
