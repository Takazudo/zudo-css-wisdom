{
  "name": "zudo-css-wisdom",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "predev": "lsof -ti :8811 | xargs kill 2>/dev/null; true",
    "dev": "zfb dev",
    "build": "zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:html": "pnpm dlx html-validate \"dist/**/*.html\"",
    "check:category-meta": "node scripts/check-category-meta.mjs",
    "check:nav-labels": "node scripts/check-nav-labels.mjs",
    "check:pin-parity": "node scripts/check-pin-parity.mjs",
    "check:wrangler-pin": "node scripts/check-wrangler-pin.mjs",
    "check:template-drift": "bash scripts/check-template-drift.sh",
    "check:links": "node scripts/check-links.js --strict-broken --allowlist=.check-links-allowlist",
    "check:redirects": "node scripts/check-redirects.mjs",
    "format:md": "pnpm dlx @takazudo/mdx-formatter --write \"src/content/**/*.{md,mdx}\"",
    "format:md:check": "pnpm dlx @takazudo/mdx-formatter --check \"src/content/**/*.{md,mdx}\"",
    "b4push": "bash scripts/run-b4push.sh",
    "generate:css-wisdom": "node scripts/generate-css-wisdom.js",
    "setup:doc-skill": "node scripts/generate-css-wisdom.js && bash scripts/setup-doc-skill.sh",
    "setup:doc-skill-silent": "node scripts/generate-css-wisdom.js && bash scripts/setup-doc-skill.sh --silent",
    "setup:doc-skill:claude": "node scripts/generate-css-wisdom.js && bash scripts/setup-doc-skill.sh --target claude",
    "setup:doc-skill:codex": "node scripts/generate-css-wisdom.js && bash scripts/setup-doc-skill.sh --target codex",
    "setup:doc-skill:both": "node scripts/generate-css-wisdom.js && bash scripts/setup-doc-skill.sh --target both"
  },
  "dependencies": {
    "@takazudo/zdtp": "0.4.12",
    "@takazudo/zfb": "2.13.1",
    "@takazudo/zfb-adapter-cloudflare": "2.13.1",
    "@takazudo/zfb-md-wasm": "2.13.1",
    "@takazudo/zfb-runtime": "2.13.1",
    "@takazudo/zudo-doc": "^5.13.1",
    "@takazudo/zudo-doc-history-server": "^5.13.1",
    "diff": "^8.0.3",
    "katex": "^0.16.38",
    "minisearch": "^7.2.0",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "lefthook": "^1.11.0",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.0",
    "wrangler": "4.85.0"
  }
}
