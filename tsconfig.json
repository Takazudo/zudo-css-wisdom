{
  "extends": "@takazudo/zudo-doc/tsconfig.base.json",
  "include": [
    "src",
    "pages",
    "zfb.config.ts",
    "zfb-shim.d.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "#doc-history-meta": [
        "./.zfb/doc-history-meta.json"
      ]
    }
  },
  "exclude": [
    "dist",
    "e2e/fixtures",
    "packages",
    "worktrees",
    "vendor",
    "src/**/__tests__",
    "scripts/__tests__",
    "vitest.config.ts"
  ]
}
